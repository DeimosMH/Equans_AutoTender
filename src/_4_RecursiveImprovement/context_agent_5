  "tender_id": "t20261010_143121_4c08",
  "project": {"id": "OBERGLATT_LUEFTUNG_DEMO", "name": "Primary School Oberglatt - Ventilation"},
  "outcome": "lost",
  "decided_on": "2026-11-05",
