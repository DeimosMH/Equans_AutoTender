  "submitted_scenario": "target",
  "margin_pct_submitted": 6.0,
  "winner": {"name": "Competitor AG", "price_chf": 541200.00, "is_us": false},
  "competitors": [
    {"name": "Competitor AG", "rank": 1, "price_chf": 541200.00},
    {"name": "Other GmbH", "rank": 2, "price_chf": 562000.00}
  ],
