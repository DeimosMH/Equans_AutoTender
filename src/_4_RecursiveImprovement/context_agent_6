### R3.1 (a) Beta-Binomial shrinkage with the MoM-trap fix - EXECUTED

```python
PRIOR_STRENGTH_DEFAULT = 10.0   # when MoM unusable (<=0 / non-finite)
PRIOR_STRENGTH_FLOOR   = 5.0    # clamp for a positive MoM estimate
PRIOR_STRENGTH_CAP     = 30.0

def mom_prior(rates):                      # MoM on segment rates
    m = sum(rates) / len(rates)
    v = sum((r - m) ** 2 for r in rates) / len(rates)
    return m, (m * (1 - m) / v - 1.0 if v > 0 else float("inf"))

def floored_prior(m, strength):            # the fix
    s = (PRIOR_STRENGTH_DEFAULT
         if strength <= 0 or strength != strength or strength == float("inf")
         else min(max(strength, PRIOR_STRENGTH_FLOOR), PRIOR_STRENGTH_CAP))
    return m * s, (1 - m) * s              # (alpha0, beta0)

def cri90(a, b, draws=200_000, seed=...):  # stdlib 90% CrI
    xs = sorted(random.Random(seed).betavariate(a, b) for _ in range(draws))
    return xs[int(0.05 * draws)], xs[int(0.95 * draws)]
```

